					<locale>en</locale>
					<schemaDirectory>src/main/resources/xsd/</schemaDirectory>
					<encoding>UTF-8</encoding>
					<episode>false</episode>
					<args>
						<arg>-Xfluent-api</arg>
						<arg>-Xsetters</arg>
					</args>
					<plugins>
						<plugin>
							<groupId>org.jvnet.jaxb</groupId>
							<artifactId>jaxb-plugins</artifactId>
							<version>${jaxb-maven-plugin.version}</version>
						</plugin>
					</plugins>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${spring-boot.version}</version>
				<configuration>
					<!-- Use PropertiesLauncher to load additional classpath -->
					<layout>ZIP</layout>
					<mainClass>ch.post.it.evoting.dataintegrationservice.DataIntegrationServiceApplication</mainClass>
					<layers>
						<enabled>false</enabled>
					</layers>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
				<version>${gmavenplus-plugin.version}</version>
				<executions>
					<execution>
						<id>remove-repeated-background</id>
						<phase>test</phase>
						<goals>
							<goal>execute</goal>
						</goals>
						<configuration>
							<scripts>
								<script><![CDATA[
                                    import groovy.json.JsonSlurper
                                    import groovy.json.JsonOutput
                                    def file = new File("target/cucumber.json")
                                    if (file.exists()) {
                                        def features = new JsonSlurper().parseText(file.text)
                                        features.each {
                                            it.elements = it.elements.unique {
                                                // background elements have no id
                                                l,r -> (l.id != null ? l.id: "0").compareTo(r.id != null ? r.id: "0")
                                            }
                                        }
                                        file.delete()
                                        file.write JsonOutput.prettyPrint(JsonOutput.toJson(features))
                                    }
                                ]]></script>
							</scripts>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>${sonar-maven-plugin.version}</version>
			</plugin>
			<plugin>
				<groupId>ch.galinet</groupId>
				<artifactId>reproducible-build-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<version>${download-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>download-openjdk-jre-win64</id>
						<goals>
							<goal>wget</goal>
						</goals>
						<phase>initialize</phase>
						<configuration>
							<followRedirects>true</followRedirects>
							<url>${openjdk-jre.win64.url}</url>
							<outputDirectory>${project.build.directory}/install/OpenJDK-win64</outputDirectory>
							<unpack>true</unpack>
							<sha256>${openjdk-jre.win64.sha256}</sha256>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>${maven-assembly-plugin.version}</version>
				<configuration>
					<descriptors>
						<descriptor>assembly.xml</descriptor>
					</descriptors>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>create-archive</id>
						<goals>
							<goal>single</goal>
						</goals>
						<phase>package</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>ch.post.it.evoting.hashgenerator</groupId>
				<artifactId>hash-generator-maven-plugin</artifactId>
				<version>1.0.0.0-b0</version>
				<configuration>
					<excludeFileTypes>jar</excludeFileTypes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>hash-generator</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>doc</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.gmavenplus</groupId>
						<artifactId>gmavenplus-plugin</artifactId>
						<executions>
							<execution>
								<id>graph-gen</id>
								<phase>compile</phase>
								<goals>
									<goal>execute</goal>
								</goals>
								<configuration>
									<scripts>
										<script><![CDATA[
															import li.chee.reactive.plumber.GraphGen
															GraphGen.generateGraphs("src/main/resources/pipes", "DataIntegrationService", "target/apidocs/")
													]]></script>
									</scripts>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>${maven-javadoc-plugin.version}</version>
						<executions>
							<execution>
								<phase>compile</phase>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<overview>target/apidocs/index.html</overview>
							<encoding>UTF-8</encoding>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>dependency-check</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<executions>
							<execution>
								<goals>
									<goal>aggregate</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
