<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>ch.post.it.evoting</groupId>
		<artifactId>evoting-dependencies</artifactId>
		<version>1.2.2.0</version>
		<relativePath>../evoting-dependencies/pom.xml</relativePath>
	</parent>

	<groupId>ch.post.it.evoting.domain</groupId>
	<artifactId>domain</artifactId>
	<version>1.2.2.0</version>
	<packaging>jar</packaging>
	<name>Domain</name>

	<properties>
		<jaxb-fluent-api.version>3.0</jaxb-fluent-api.version>
		<jaxb2-basics.version>0.11.1</jaxb2-basics.version>
		<jaxb2-namespace-prefix.version>1.3</jaxb2-namespace-prefix.version>
		<maven-jaxb2-plugin.version>0.15.1</maven-jaxb2-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>javax.xml.bind</groupId>
				<artifactId>jaxb-api</artifactId>
				<version>${jaxb-api.version}</version>
			</dependency>
			<dependency>
				<groupId>com.sun.xml.bind</groupId>
				<artifactId>jaxb-impl</artifactId>
				<version>${jaxb-impl.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Internal dependencies -->
		<dependency>
			<groupId>ch.post.it.evoting.cryptoprimitives</groupId>
			<artifactId>crypto-primitives</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.post.it.evoting.cryptolib</groupId>
			<artifactId>cryptolib</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.post.it.evoting.cryptoprimitives.domain</groupId>
			<artifactId>crypto-primitives-domain</artifactId>
		</dependency>

		<!-- External dependencies -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish</groupId>
			<artifactId>javax.json</artifactId>
		</dependency>

		<!-- com.fasterxml.jackson -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Testing dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-inline</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.post.it.evoting.cryptoprimitives</groupId>
			<artifactId>crypto-primitives</artifactId>
			<classifier>tests</classifier>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-csv</artifactId>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-impl</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<environmentVariables>
						<SECURITY_LEVEL>TESTING_ONLY</SECURITY_LEVEL>
					</environmentVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jvnet.jaxb2.maven2</groupId>
				<artifactId>maven-jaxb2-plugin</artifactId>
				<version>${maven-jaxb2-plugin.version}</version>
				<executions>
					<execution>
						<id>evoting-decrypt</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<locale>en</locale>
							<schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
							<schemaIncludes>evoting-decrypt-1-3.xsd</schemaIncludes>
							<generateDirectory>${basedir}/target/generated-sources/java/evotingdecrypt</generateDirectory>
							<generatePackage>ch.post.it.evoting.domain.xmlns.evotingdecrypt</generatePackage>
							<episode>false</episode>
							<args>
								<arg>-Xfluent-api</arg>
								<arg>-Xsetters</arg>
							</args>
							<plugins>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-fluent-api</artifactId>
									<version>${jaxb-fluent-api.version}</version>
								</plugin>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-basics</artifactId>
									<version>${jaxb2-basics.version}</version>
								</plugin>
							</plugins>
						</configuration>
					</execution>
					<execution>
						<id>evoting-config</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<locale>en</locale>
							<schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
							<schemaIncludes>evoting-config-4-4.xsd</schemaIncludes>
							<generateDirectory>${basedir}/target/generated-sources/java/evotingconfig</generateDirectory>
							<generatePackage>ch.post.it.evoting.domain.xmlns.evotingconfig</generatePackage>
							<episode>false</episode>
							<args>
								<arg>-Xfluent-api</arg>
								<arg>-Xsetters</arg>
							</args>
							<plugins>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-fluent-api</artifactId>
									<version>${jaxb-fluent-api.version}</version>
								</plugin>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-basics</artifactId>
									<version>${jaxb2-basics.version}</version>
								</plugin>
							</plugins>
						</configuration>
					</execution>
					<execution>
						<id>eCH files</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<locale>en</locale>
							<schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
							<schemaIncludes>eCH-*.xsd</schemaIncludes>
							<bindingDirectory>src/main/resources/xsd</bindingDirectory>
							<bindingIncludes>
								<include>bindings.xml</include>
							</bindingIncludes>
							<episode>false</episode>
							<args>
								<arg>-Xfluent-api</arg>
								<arg>-Xsetters</arg>
								<arg>-extension</arg>
								<arg>-Xnamespace-prefix</arg>
							</args>
							<plugins>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-fluent-api</artifactId>
									<version>${jaxb-fluent-api.version}</version>
								</plugin>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-basics</artifactId>
									<version>${jaxb2-basics.version}</version>
								</plugin>
							</plugins>
						</configuration>
					</execution>
					<execution>
						<id>evoting-print</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<locale>en</locale>
							<schemaDirectory>${basedir}/src/main/resources/xsd</schemaDirectory>
							<schemaIncludes>evoting-print-1-2.xsd</schemaIncludes>
							<generateDirectory>${basedir}/target/generated-sources/java/evotingprint</generateDirectory>
							<generatePackage>ch.post.it.evoting.domain.xmlns.evotingprint</generatePackage>
							<episode>false</episode>
							<args>
								<arg>-Xfluent-api</arg>
								<arg>-Xsetters</arg>
							</args>
							<plugins>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-fluent-api</artifactId>
									<version>${jaxb-fluent-api.version}</version>
								</plugin>
								<plugin>
									<groupId>org.jvnet.jaxb2_commons</groupId>
									<artifactId>jaxb2-basics</artifactId>
									<version>${jaxb2-basics.version}</version>
								</plugin>
							</plugins>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.jvnet.jaxb2_commons</groupId>
						<artifactId>jaxb2-namespace-prefix</artifactId>
						<version>${jaxb2-namespace-prefix.version}</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>ch.galinet</groupId>
				<artifactId>reproducible-build-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
